project:
  type: website
  output-dir: _site

website:
  title: "MECH 501/600 — Computational Turbulence"
  description: "Tutorials for MECH 501/600, McGill University"
  site-url: https://mcgillteaching.github.io/MECH501_tutorial/
  favicon: assets/logo.svg
  navbar:
    background: primary
    logo: assets/logo.svg
    logo-alt: "MECH 501/600 vortex logo"
    left:
      - href: index.qmd
        text: Home
      - text: Cluster
        href: cluster/index.qmd
      - text: Python
        href: python/index.qmd
      - text: OpenFOAM
        href: openfoam/how-to.qmd
      - text: "Tutorials & Assignments"
        href: tutorials/tutorial-00.qmd
    right:
      - icon: github
        href: https://github.com/mcgillteaching/MECH501_tutorial
  sidebar:
    style: docked
    search: true
    collapse-level: 1
    logo: assets/logo-full.svg
    contents:
      - index.qmd
      - section: "Cluster"
        contents:
          - cluster/index.qmd
          - cluster/registration.qmd
          - cluster/intro.qmd
          - cluster/jupyterlab.qmd
          - cluster/vscode.qmd
          - cluster/terminal.qmd
      - section: "Python"
        contents:
          - python/index.qmd
          - python/01-plotting.ipynb
          - python/02-foundations.ipynb
          - python/03-oop.ipynb
          - python/04-functional.ipynb
          - python/05-internals.ipynb
          - python/06-engineering.ipynb
          - python/07-packaging.ipynb
      - section: "OpenFOAM"
        contents:
          - openfoam/how-to.qmd
      - section: "Tutorials and Assignments"
        contents:
          - tutorials/tutorial-00.qmd
          - tutorials/assignment-01-dns.qmd
          - tutorials/assignment-01-processing.ipynb
          - tutorials/assignment-02-correlations.qmd
          - tutorials/assignment-02b-openfoam.qmd
  page-footer:
    left: "© 2026 Hendrik Nicolai · MECH 501/600 · McGill University"
    right: "Built with [Quarto](https://quarto.org)"

bibliography: references.bib
csl: assets/numeric.csl

crossref:
  eq-prefix: "Eq."
  fig-prefix: "Fig."
  tbl-prefix: "Tab."

format:
  html:
    theme:
      light: [flatly, theme-light.scss]
      dark: [darkly, theme-dark.scss]
    css: styles.css
    include-after-body: expand-tutorials.html
    toc: true
    toc-depth: 3
    number-sections: true
    code-copy: true
    highlight-style:
      light: github
      dark: github
    link-external-newwindow: true

execute:
  freeze: auto   # only re-run Python when the source file changes

profile:
  default: student
  group:
    - [student, solutions]
